{
  "name": "east-asian-teaware-gallery",
  "version": "1.0.0",
  "description": "东亚茶器艺术展 - East Asian Teaware Art Exhibition",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/verify-teaware.mjs && node scripts/build-exhibit-layout.mjs && next build && node scripts/package-collection-images.mjs && node scripts/remove-artwork-rsc-payloads.mjs && cp public/spa-fallback.html out/404.html",
    "start": "next start",
    "lint": "eslint",
    "collection:audit": "node scripts/audit-teaware.mjs",
    "collection:verify": "node scripts/verify-teaware.mjs",
    "cutouts:inventory": "node scripts/inventory-cutouts.mjs",
    "cutouts:review": "node scripts/review-collection-cutouts.mjs",
    "cutouts:publish": "node scripts/publish-collection-cutouts.mjs",
    "fetch-data": "npx tsx scripts/fetch-artworks-v3.ts",
    "fetch-data-legacy": "npx tsx scripts/fetch-artworks.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
